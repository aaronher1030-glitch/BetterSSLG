+      }),
+      appendRow: row => rows.push(row),
+      getLastColumn: () => rows[0] ? rows[0].length : 0,
+      getFrozenRows: () => 0,
+      setFrozenRows: () => {}
+    };
+  }
+
+  const spreadsheet = {
+    getSheetByName: name => sheets.has(name) ? makeSheet(name) : null,
+    insertSheet: name => { sheets.set(name, []); return makeSheet(name); }
+  };
+
+  const context = vm.createContext({
+    console,
+    Date,
+    Intl,
+    JSON,
+    PropertiesService: { getScriptProperties: () => ({ getProperty: key => properties[key] || null }) },
+    SpreadsheetApp: { openById: () => spreadsheet },
+    LockService: { getScriptLock: () => ({ tryLock: () => true, releaseLock: () => {} }) },
+    Utilities: { getUuid: () => `uuid-${++uuid}` },
+    ScriptApp: { getService: () => ({ getUrl: () => baseUrl }) },
+    HtmlService: { createTemplateFromFile: () => ({ evaluate: () => 'html' }) },
+    ContentService: {
+      MimeType: { JSON: 'application/json' },
+      createTextOutput: text => ({ setMimeType: () => ({ text }) })
+    }
+  });
+
+  vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'Core.gs'), 'utf8'), context);
+  vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'Code.gs'), 'utf8'), context);
+  return { context, sheets };
+}
+
+function post(backend, action, payload) {
+  const output = backend.context.doPost({ postData: { contents: JSON.stringify({ action, payload }) } });
+  return JSON.parse(output.text);
+}
+
+function today_(backend) {
+  return backend.context.manilaDateKey_(new Date());
+}
+
+test('creates the documented Sheet tabs and headers', () => {
+  const backend = loadBackend();
+  backend.context.ensureSchema_();
+  assert.deepEqual(Array.from(backend.sheets.get('Daily Codes')[0]), ['date', 'in_code', 'out_code', 'created_at', 'created_by']);
+  assert.deepEqual(Array.from(backend.sheets.get('People')[0]), ['device_token', 'name', 'first_seen_at', 'last_seen_at']);
+  assert.deepEqual(Array.from(backend.sheets.get('Attendance')[0]), ['event_id', 'date', 'scanned_at', 'mode', 'name', 'device_token', 'qr_created_at']);
+});
+
+test('generates daily codes and invalidates the previous pair', () => {
+  const backend = loadBackend();
+  const date = today_(backend);
+  const first = backend.context.generateDailyCodes_(date);
+  const second = backend.context.generateDailyCodes_(date);
+  assert.notEqual(first.in_code, second.in_code);
+  assert.equal(post(backend, 'scan.status', { date, mode: 'IN', code: first.in_code, device_token: 'device-a' }).error, 'INVALID_CODE');
+  assert.equal(post(backend, 'scan.status', { date, mode: 'OUT', code: second.out_code, device_token: 'device-a' }).ok, true);
+  assert.equal(backend.sheets.get('Daily Codes').length, 2);
+});
+
+test('registers a device once and records every valid scan', () => {
+  const backend = loadBackend();
+  const date = today_(backend);
+  const generated = backend.context.generateDailyCodes_(date);
+  const first = post(backend, 'scan.record', {
+    date, mode: 'IN', code: generated.in_code,
+    device_token: 'device-a', name: '  Ana   Cruz '
+  });
+  assert.equal(first.ok, true);
+  assert.equal(first.event.name, 'Ana Cruz');
+  const status = post(backend, 'scan.status', {
+    date, mode: 'OUT', code: generated.out_code, device_token: 'device-a'
+  });
+  assert.equal(status.name, 'Ana Cruz');
+  const second = post(backend, 'scan.record', {
+    date, mode: 'OUT', code: generated.out_code, device_token: 'device-a'
+  });
+  const third = post(backend, 'scan.record', {
+    date, mode: 'IN', code: generated.in_code, device_token: 'device-a'
+  });
+  assert.equal(second.ok, true);
+  assert.equal(third.ok, true);
+  assert.equal(backend.sheets.get('People').length, 2);
+  assert.equal(backend.sheets.get('Attendance').length, 4);
+});
+
+test('rejects invalid codes without writing attendance', () => {
+  const backend = loadBackend();
+  const date = today_(backend);
+  backend.context.generateDailyCodes_(date);
+  const result = post(backend, 'scan.record', {
+    date, mode: 'IN', code: 'wrong', device_token: 'device-a', name: 'Ana Cruz'
+  });
+  assert.equal(result.ok, false);
+  assert.equal(backend.sheets.get('Attendance').length, 1);
+});
+
+test('filters attendance and exports CSV', () => {
+  const backend = loadBackend();
+  const date = today_(backend);
+  const generated = backend.context.generateDailyCodes_(date);
+  post(backend, 'scan.record', { date, mode: 'IN', code: generated.in_code, device_token: 'device-a', name: 'Ana Cruz' });
+  const listed = backend.context.listAttendance_(date, 'ana');
+  assert.equal(listed.rows.length, 1);
+  assert.equal(listed.totals.in, 1);
+  const exported = backend.context.exportAttendanceCsv_(date);
+  assert.equal(exported.ok, true);
+  assert.match(exported.csv, /"Ana Cruz"/);
+});
diff -ruN '--exclude=node_modules' ../.superpowers/sdd/2026-11-24-sslg-qr-attendance/before-task-1/tests/client-admin.test.cjs ./tests/client-admin.test.cjs
--- ../.superpowers/sdd/2026-11-24-sslg-qr-attendance/before-task-1/tests/client-admin.test.cjs	1970-01-01 08:00:00.000000000 +0800
+++ ./tests/client-admin.test.cjs	2026-11-24 14:52:50.886640000 +0800
@@ -0,0 +1,203 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+const client = fs.readFileSync(path.join(__dirname, '..', 'Client.html'), 'utf8');
+const script = client.match(/<script>([\s\S]*?)<\/script>/)[1];
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((resolvePromise, rejectPromise) => {
+    resolve = resolvePromise;
+    reject = rejectPromise;
+  });
+  return { promise, resolve, reject };
+}
+
+function attendanceResult(date, name, scans) {
+  return {
+    ok: true,
+    totals: { scans, people: 1, in: scans, out: 0 },
+    rows: [{ scanned_at: '08:00', name, mode: 'IN' }]
+  };
+}
+
+function flush() {
+  return new Promise(resolve => setImmediate(resolve));
+}
+
+async function renderedAdmin(api) {
+  const elements = new Map();
+
+  class FakeElement {
+    constructor(id) {
+      this.id = id;
+      this.innerHTML = '';
+      this.textContent = '';
+      this.value = '';
+      this.hidden = false;
+      this.disabled = false;
+      this.listeners = new Map();
+    }
+
+    addEventListener(type, listener) {
+      this.listeners.set(type, listener);
+    }
+
+    dispatch(type) {
+      const listener = this.listeners.get(type);
+      if (listener) listener({ preventDefault() {} });
+    }
+
+    click() {}
+    remove() {}
+  }
+
+  for (const id of [
+    'app',
+    'admin-date',
+    'generate-codes',
+    'admin-error',
+    'qr-pair',
+    'attendance-search',
+    'attendance-totals',
+    'attendance-body',
+    'export-csv'
+  ]) {
+    elements.set(id, new FakeElement(id));
+  }
+  elements.get('admin-date').value = '2026-11-24';
+  elements.get('admin-error').hidden = true;
+  elements.get('qr-pair').hidden = true;
+
+  const document = {
+    getElementById(id) {
+      if (!elements.has(id)) elements.set(id, new FakeElement(id));
+      return elements.get(id);
+    },
+    addEventListener() {},
+    createElement() { return new FakeElement(); },
+    body: { appendChild() {} }
+  };
+  const context = vm.createContext({
+    console,
+    document,
+    window: {
+      qrcode() {
+        return {
+          addData(value) { this.value = value; },
+          make() {},
+          createDataURL() { return `data:image/png;base64,${this.value}`; }
+        };
+      }
+    },
+    confirm: () => true,
+    location: { search: '?page=admin' },
+    URLSearchParams,
+    Blob,
+    URL: { createObjectURL: () => 'blob:attendance', revokeObjectURL() {} },
+    setTimeout: callback => callback()
+  });
+  vm.runInContext(script, context, { filename: 'Client.html' });
+  context.api = api;
+  await context.renderAdminPage_();
+  return { context, elements };
+}
+
+test('a late generation response cannot redisplay QR cards for a previous date', async () => {
+  const generation = deferred();
+  const changedDateList = deferred();
+  const { context, elements } = await renderedAdmin(() => Promise.resolve(attendanceResult('2026-11-24', 'Initial', 1)));
+  context.api = action => action === 'admin.generate' ? generation.promise : changedDateList.promise;
+
+  const pendingGeneration = context.generateCodes_('2026-11-24');
+  elements.get('admin-date').value = '2026-11-25';
+  elements.get('admin-date').dispatch('change');
+  changedDateList.resolve(attendanceResult('2026-11-25', 'New date', 2));
+  await flush();
+
+  generation.resolve({
+    ok: true,
+    record: {
+      date: '2026-11-24',
+      created_at: '2026-11-24 07:00',
+      in_url: 'https://script.test/exec?page=scan&date=2026-11-24&mode=IN&code=old-in',
+      out_url: 'https://script.test/exec?page=scan&date=2026-11-24&mode=OUT&code=old-out'
+    }
+  });
+  await pendingGeneration;
+
+  assert.equal(elements.get('qr-pair').hidden, true);
+  assert.doesNotMatch(elements.get('qr-pair').innerHTML, /2026-11-24|old-in|old-out/);
+  assert.match(elements.get('attendance-body').innerHTML, /New date/);
+  assert.doesNotMatch(elements.get('attendance-body').innerHTML, /Initial/);
+});
+
+test('an older attendance response cannot overwrite a newer search result', async () => {
+  const requests = [];
+  const { context, elements } = await renderedAdmin(() => Promise.resolve(attendanceResult('2026-11-24', 'Initial', 1)));
+  context.api = () => {
+    const request = deferred();
+    requests.push(request);
+    return request.promise;
+  };
+
+  const olderRequest = context.loadAttendance_('2026-11-24', 'Ada');
+  elements.get('attendance-search').value = 'Luis';
+  elements.get('attendance-search').dispatch('input');
+  requests[1].resolve(attendanceResult('2026-11-24', 'Luis', 3));
+  await flush();
+  requests[0].resolve(attendanceResult('2026-11-24', 'Ada', 1));
+  await olderRequest;
+
+  assert.match(elements.get('attendance-body').innerHTML, /Luis/);
+  assert.doesNotMatch(elements.get('attendance-body').innerHTML, /Ada/);
+  assert.match(elements.get('attendance-totals').innerHTML, /<strong>3<\/strong>/);
+});
+
+test('an older attendance failure cannot resurface an error after a newer search succeeds', async () => {
+  const requests = [];
+  const { context, elements } = await renderedAdmin(() => Promise.resolve(attendanceResult('2026-11-24', 'Initial', 1)));
+  context.api = () => {
+    const request = deferred();
+    requests.push(request);
+    return request.promise;
+  };
+
+  elements.get('attendance-search').value = 'Ada';
+  elements.get('attendance-search').dispatch('input');
+  elements.get('attendance-search').value = 'Luis';
+  elements.get('attendance-search').dispatch('input');
+  requests[1].resolve(attendanceResult('2026-11-24', 'Luis', 1));
+  await flush();
+  requests[0].reject(new Error('SHEET_BUSY'));
+  await flush();
+
+  assert.equal(elements.get('admin-error').hidden, true);
+  assert.match(elements.get('attendance-body').innerHTML, /Luis/);
+});
+
+test('starting list and export requests hides a recovered office error', async () => {
+  const listRequest = deferred();
+  const exportRequest = deferred();
+  const { context, elements } = await renderedAdmin(() => Promise.resolve(attendanceResult('2026-11-24', 'Initial', 1)));
+
+  elements.get('admin-error').textContent = 'Previous failure';
+  elements.get('admin-error').hidden = false;
+  context.api = () => listRequest.promise;
+  const pendingList = context.loadAttendance_('2026-11-24', '');
+  assert.equal(elements.get('admin-error').hidden, true);
+  listRequest.resolve(attendanceResult('2026-11-24', 'Recovered', 1));
+  await pendingList;
+
+  elements.get('admin-error').textContent = 'Previous failure';
+  elements.get('admin-error').hidden = false;
+  context.api = () => exportRequest.promise;
+  const pendingExport = context.downloadCsv_('2026-11-24');
+  assert.equal(elements.get('admin-error').hidden, true);
+  exportRequest.resolve({ ok: true, csv: 'Time,Name\n', filename: 'attendance-2026-11-24.csv' });
+  await pendingExport;
+});
